# JsonRPC server details (Python tests & tooling)
# Use RPCHOST=localhost when running the simulator natively on your machine.
# Use RPCHOST=jsonrpc when tests run inside the GenLayer Studio Docker network.
RPCPROTOCOL         = 'http'
RPCHOST             = 'localhost'
RPCPORT             = '4000'

# LLM validators for pytest (Ollama local — no API keys)
GENLAYER_VALIDATOR_PROVIDER = 'ollama'
GENLAYER_VALIDATOR_MODEL    = 'llama3'
